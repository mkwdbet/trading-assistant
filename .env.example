APP_ENV=local
APP_HOST=0.0.0.0
APP_PORT=8000

# SQLite for MVP. Use postgresql+psycopg://user:pass@db:5432/trading_assistant later.
DATABASE_URL=sqlite:///./data/trading_assistant.sqlite3

# Shared secret used by TradingView webhook URLs.
TRADINGVIEW_WEBHOOK_SECRET=change-me

# KakaoTalk Channel integration.
# For channel-originated alerts, use Kakao Business Message such as AlimTalk/FriendTalk
# through Kakao Business or a message provider. The exact endpoint/body differs by provider.
KAKAO_CHANNEL_PROVIDER_URL=
KAKAO_CHANNEL_API_KEY=
KAKAO_CHANNEL_SENDER_KEY=
KAKAO_CHANNEL_ID=
KAKAO_CHANNEL_RECIPIENT_PHONE=
KAKAO_CHANNEL_TEMPLATE_CODE=TRADING_SIGNAL

# Notification switch for local development.
ENABLE_KAKAO_NOTIFICATIONS=false

# Discord webhook integration. Recommended for the first free MVP alert channel.
DISCORD_WEBHOOK_URL=
DISCORD_USERNAME=AlphaForge
ENABLE_DISCORD_NOTIFICATIONS=false

# Hypothetical signal performance tracking.
ENABLE_OUTCOME_TRACKING=true
OUTCOME_TRACKER_INTERVAL_SECONDS=300
