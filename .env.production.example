APP_ENV=production
APP_HOST=0.0.0.0
APP_PORT=8000

DATABASE_URL=sqlite:///./data/trading_assistant.sqlite3

# Replace with a long random value before updating TradingView.
TRADINGVIEW_WEBHOOK_SECRET=replace-with-long-random-secret

# Caddy HTTPS settings.
PUBLIC_DOMAIN=alerts.example.com
ACME_EMAIL=you@example.com

# Discord webhook integration.
DISCORD_WEBHOOK_URL=
DISCORD_USERNAME=Trading Assistant
ENABLE_DISCORD_NOTIFICATIONS=true

# KakaoTalk Channel integration, optional later.
KAKAO_CHANNEL_PROVIDER_URL=
KAKAO_CHANNEL_API_KEY=
KAKAO_CHANNEL_SENDER_KEY=
KAKAO_CHANNEL_ID=
KAKAO_CHANNEL_RECIPIENT_PHONE=
KAKAO_CHANNEL_TEMPLATE_CODE=TRADING_SIGNAL
ENABLE_KAKAO_NOTIFICATIONS=false

